{{define "structs"}}
    {{ range $i, $v := (MakeIterable $.Messages.Len) }}
        {{ $message := $.Messages.Get $i }}
        {{ if not $message.IsMapEntry }}
            {{template "structs" $message}}
        {{end}}
    {{end}}
    {{ range $i, $v := (MakeIterable $.Fields.Len) -}}
        {{ $field := $.Fields.Get $i }}
        {{ if $field.IsMap }}
            {{ $mapKeyValue := FindValue $field.MapKey }}
            {{ $mapValueValue := FindValue $field.MapValue }}
            type {{ CamelCase $field.FullName }}Map map[{{ $mapKeyValue }}]{{ $mapValueValue }}
            func New{{ CamelCase $field.FullName }}Map (size uint32) map[{{ $mapKeyValue }}]{{$mapValueValue}} {
                return make(map[{{ $mapKeyValue }}]{{ $mapValueValue }}, size)
            }

            {{template "encodeMap" $field}}
            {{template "decodeMap" $field}}
        {{end}}
    {{end -}}
    {{ range $oneof := GetRealOneofs .Oneofs -}}
        type {{ OneofCaseType $ $oneof }} uint32

        const (
            {{ OneofNotSetConst $ $oneof }} {{ OneofCaseType $ $oneof }} = 0
            {{ range $i, $v := (MakeIterable $oneof.Fields.Len) -}}
                {{ $field := $oneof.Fields.Get $i -}}
                {{ OneofCaseConst $ $oneof $field }} {{ OneofCaseType $ $oneof }} = {{ $field.Number }}
            {{end -}}
        )
    {{end -}}
    type {{ CamelCase .FullName }} struct {
        {{ CustomFields }}

        {{ range $oneof := GetRealOneofs .Oneofs -}}
            {{ FirstLowerCase (CamelCaseName $oneof.Name) }}Case {{ OneofCaseType $ $oneof }}
        {{end -}}

        {{ range $i, $v := (MakeIterable $.Fields.Len) -}}
            {{ $field := $.Fields.Get $i -}}
            {{ $value := FindValue $field -}}
            {{ CamelCaseName $field.Name }} {{ $value }}
        {{end -}}
    }

    {{template "getFunc" .}}
    {{template "error" .}}
    {{template "encode" .}}
    {{template "decode" .}}
    {{template "internalDecode" .}}
    {{ range $oneof := GetRealOneofs .Oneofs -}}
        func (x *{{ CamelCase $.FullName }}) Which{{ CamelCaseName $oneof.Name }}() {{ OneofCaseType $ $oneof }} {
            if x == nil {
                return {{ OneofNotSetConst $ $oneof }}
            }
            return x.{{ FirstLowerCase (CamelCaseName $oneof.Name) }}Case
        }

        func (x *{{ CamelCase $.FullName }}) Clear{{ CamelCaseName $oneof.Name }}() {
            if x == nil {
                return
            }
            x.{{ FirstLowerCase (CamelCaseName $oneof.Name) }}Case = {{ OneofNotSetConst $ $oneof }}
            {{ range $i, $v := (MakeIterable $oneof.Fields.Len) -}}
                {{ $field := $oneof.Fields.Get $i -}}
                x.{{ CamelCaseName $field.Name }} = {{ ZeroValue $field }}
            {{end -}}
        }

        {{ range $i, $v := (MakeIterable $oneof.Fields.Len) -}}
            {{ $field := $oneof.Fields.Get $i -}}
            func (x *{{ CamelCase $.FullName }}) Set{{ CamelCaseName $field.Name }}(value {{ FindValue $field }}) {
                x.Clear{{ CamelCaseName $oneof.Name }}()
                x.{{ CamelCaseName $field.Name }} = value
                x.{{ FirstLowerCase (CamelCaseName $oneof.Name) }}Case = {{ OneofCaseConst $ $oneof $field }}
            }

            func (x *{{ CamelCase $.FullName }}) Get{{ CamelCaseName $field.Name }}() {{ FindValue $field }} {
                if x == nil || x.{{ FirstLowerCase (CamelCaseName $oneof.Name) }}Case != {{ OneofCaseConst $ $oneof $field }} {
                    return {{ ZeroValue $field }}
                }
                return x.{{ CamelCaseName $field.Name }}
            }
        {{end -}}
    {{end -}}
{{end}}

{{define "getFunc"}}
func New{{ CamelCase .FullName }}() *{{ CamelCase .FullName }} {
    return &{{ CamelCase .FullName }}{}
}
{{end}}

{{define "error"}}
func (x *{{CamelCase .FullName}}) encodeError(b *polyglot.Buffer, err error) {
    polyglot.Encoder(b).Error(err)
}
{{ if not (HasErrorField .Fields) -}}
func (x *{{CamelCase .FullName}}) Error(b *polyglot.Buffer, err error) {
    x.encodeError(b, err)
}
{{end -}}
{{end}}
